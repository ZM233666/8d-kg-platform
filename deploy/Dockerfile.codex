# Codex 抽取服务：uvicorn + OpenAI Codex CLI (codex exec)
# docker build -f deploy/Dockerfile.codex -t 8dkg-codex:local .

FROM python:3.11-slim-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        nodejs \
        npm \
    && npm install -g @openai/codex \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

COPY pyproject.toml uv.lock README.md ./
COPY backend ./backend

RUN uv sync --frozen --no-dev

ENV PYTHONPATH=/app/backend \
    PATH="/app/.venv/bin:${PATH}" \
    CODEX_EXEC_WORKDIR=/app

COPY deploy/scripts/codex-entrypoint.sh /usr/local/bin/codex-entrypoint.sh
RUN chmod +x /usr/local/bin/codex-entrypoint.sh

EXPOSE 8787

ENTRYPOINT ["/usr/local/bin/codex-entrypoint.sh"]
