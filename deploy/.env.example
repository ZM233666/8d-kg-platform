# 复制为 deploy/.env 后填入真实值（勿提交 git）
# 在仓库根目录执行: docker compose -f deploy/docker-compose.yml --env-file deploy/.env ...

ENV=production
LOG_LEVEL=INFO
DEBUG=false
STRICT_STARTUP=false

# === Postgres ===
POSTGRES_USER=kguser
POSTGRES_PASSWORD=__REPLACE_ME__
POSTGRES_DB=kg
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://kguser:__REPLACE_ME__@postgres:5432/kg
ALEMBIC_DATABASE_URL=postgresql+psycopg://kguser:__REPLACE_ME__@postgres:5432/kg

# === Neo4j ===
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=__REPLACE_ME__
NEO4J_DATABASE=neo4j

# === Redis ===
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=__REPLACE_ME__
REDIS_URL=redis://:__REPLACE_ME__@redis:6379/0
CELERY_BROKER_URL=redis://:__REPLACE_ME__@redis:6379/1
CELERY_RESULT_BACKEND=redis://:__REPLACE_ME__@redis:6379/2

# === MinIO ===
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=kgadmin
MINIO_SECRET_KEY=__REPLACE_ME__
MINIO_BUCKET=kg-documents
MINIO_SECURE=false

# === LLM ===
LLM_PROVIDER=codex
LLM_FALLBACK_PROVIDER=litellm
LLM_PRIMARY_SOFT_TIMEOUT_SECONDS=30

# === Codex Extractor Service ===
CODEX_BASE_URL=http://codex:8787
CODEX_EXTRACT_PATH=/extract
CODEX_TIMEOUT_SECONDS=120
CODEX_MAX_RETRIES=2
CODEX_SKILL_NAME=8d-report-extraction-core
CODEX_SKILL_VERSION=draft
CODEX_EXECUTOR_LABEL=codex-docker
CODEX_CLI_PATH=codex
CODEX_EXEC_WORKDIR=/app
# CODEX_EXEC_MODEL=gpt-5.4

# Codex CLI 鉴权（按实际网关填写）
OPENAI_API_KEY=__REPLACE_ME__
# OPENAI_BASE_URL=https://api.openai.com/v1

# === LiteLLM 兜底 ===
LITELLM_API_KEY=__REPLACE_ME__
LITELLM_BASE_URL=http://117.62.232.51:14000/v1
LITELLM_MODEL=gpt-5.4
LITELLM_TIMEOUT_SECONDS=60
LITELLM_MAX_RETRIES=3

# === 应用 ===
SECRET_KEY=__GENERATE_WITH_openssl_rand_hex_32__
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS_RAW=http://localhost,http://127.0.0.1

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
