# 复制此文件为 .env 并填入真实密码（.env 已在 .gitignore，不会入库）
# 真实密码源：服务器 /opt/8d-kg-infra/.env 或本地密码管理器

ENV=local
LOG_LEVEL=DEBUG

# === Postgres（本地 5432 → 远端容器 15432）===
POSTGRES_USER=kguser
POSTGRES_PASSWORD=__REPLACE_ME__
POSTGRES_DB=kg
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://kguser:__REPLACE_ME__@localhost:5432/kg
ALEMBIC_DATABASE_URL=postgresql+psycopg://kguser:__REPLACE_ME__@localhost:5432/kg

# === Neo4j（本地 7474/7687 → 远端容器 17474/17687）===
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=__REPLACE_ME__
NEO4J_DATABASE=neo4j

# === Redis（本地 6379 → 远端容器 26379）===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=__REPLACE_ME__
REDIS_URL=redis://:__REPLACE_ME__@localhost:6379/0
CELERY_BROKER_URL=redis://:__REPLACE_ME__@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:__REPLACE_ME__@localhost:6379/2

# === MinIO（本地 9000/9001 → 远端容器 19000/19001）===
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=kgadmin
MINIO_SECRET_KEY=__REPLACE_ME__
MINIO_BUCKET=kg-documents
MINIO_SECURE=false
MINIO_CONSOLE=http://localhost:9001

# === LLM（默认走本地 Codex 抽取服务）===
LLM_PROVIDER=codex
LLM_FALLBACK_PROVIDER=litellm
LLM_PRIMARY_SOFT_TIMEOUT_SECONDS=30

# === Codex Extractor Service ===
CODEX_BASE_URL=http://127.0.0.1:8787
CODEX_EXTRACT_PATH=/extract
CODEX_TIMEOUT_SECONDS=120
CODEX_MAX_RETRIES=2
CODEX_SKILL_NAME=8d-report-extraction-core
CODEX_SKILL_VERSION=draft
CODEX_EXECUTOR_LABEL=codex-local

# === LiteLLM（Azure 模型网关，作为 Codex 失败时兜底）===
LITELLM_API_KEY=__REPLACE_ME__
LITELLM_BASE_URL=http://117.62.232.51:14000/v1
LITELLM_MODEL=gpt-5.4
LITELLM_TIMEOUT_SECONDS=60
LITELLM_MAX_RETRIES=3

# === 应用 ===
SECRET_KEY=__GENERATE_WITH_openssl_rand_hex_32__
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
